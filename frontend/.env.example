# 이 파일은 키 이름만 남긴다. 실제 값은 .env.local에 넣고 커밋하지 않는다.

# 브라우저가 직접 호출하는 백엔드 주소. 백엔드의 CORS 허용 출처와 짝을 이룬다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 카카오 개발자 콘솔의 REST API 키
NEXT_PUBLIC_KAKAO_CLIENT_ID=

# 카카오 콘솔에 등록한 것과 문자 하나까지 같아야 한다.
# 백엔드도 인가코드를 교환할 때 같은 값을 보낸다(KAKAO_REDIRECT_URI).
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/callback
