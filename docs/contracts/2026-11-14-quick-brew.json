{
  "openapi": "3.0.3",
  "info": {
    "title": "빠른 기록 — 오늘 홈 · 빠른 기록 시트 · 기록 탭",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/brew-logs": {
      "post": {
        "operationId": "createBrewLog",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrewLogCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성됨 — brewedAt이 없으면 서버 시각",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrewLog"
                }
              }
            }
          },
          "400": {
            "description": "원두량·물량 누락·0 이하, beanProductId+beanName 동시, beanName 101자 이상, roastedAt이 기록 날짜보다 늦음, 그라인더 없는 분쇄도 — code INVALID_REQUEST"
          },
          "401": {
            "description": "인증 없음"
          },
          "403": {
            "description": "남의 그라인더·원두 봉투·볼 수 없는 레시피 — code FORBIDDEN"
          },
          "404": {
            "description": "없는 beanProductId·recipeId·userGrinderId — code NOT_FOUND"
          }
        }
      },
      "get": {
        "operationId": "listBrewLogs",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "recipeId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "beanBatchId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minRating",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공 — 「지난번」은 ?userId={me}&size=1의 첫 항목",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageOfBrewLogSummary"
                }
              }
            }
          },
          "400": {
            "description": "파라미터 형식·범위 위반 — code INVALID_REQUEST"
          },
          "401": {
            "description": "인증 없음"
          }
        }
      }
    },
    "/api/v1/brew-logs/{id}": {
      "get": {
        "operationId": "getBrewLog",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
