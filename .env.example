# OAuth 실기 검증용 크레덴셜.
#
#   cp .env.example .env    후 값을 채운다. .env는 gitignore되어 커밋되지 않는다.
#
# 사용법:
#   set -a && source .env && set +a
#   cd backend && ./gradlew bootRun --args='--spring.profiles.active=local'
#
# 값이 없으면 application-local.yml이 dummy로 떨어지므로 기동 자체는 항상 된다.

# 카카오 — developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
# 카카오 로그인 활성화 ON, 동의항목에서 닉네임 필수 지정.
# 이메일은 선택 동의라 null이 올 수 있고, 코드가 이미 대응한다.
KAKAO_CLIENT_ID=
# 보안 강화(client_secret)를 켰을 때만 필요. 안 켰으면 비워둔다.
KAKAO_CLIENT_SECRET=

# 구글 — console.cloud.google.com > API 및 서비스 > 사용자 인증 정보
# OAuth 클라이언트 ID > 웹 애플리케이션
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 두 콘솔 모두에 아래 값을 Redirect URI로 등록해야 한다.
# 프론트가 아직 없어 이 주소는 응답하지 않지만, 브라우저 주소창의 ?code= 값을 읽으면 된다.
KAKAO_REDIRECT_URI=http://localhost:3000/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
