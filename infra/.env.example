# 실제 값을 채운 .env 파일을 VM의 /opt/kaldi-note/infra/ 안에 직접 만든다.
# .env는 git에 커밋하지 않는다 (루트 .gitignore의 .env / .env.* 패턴에 이미 걸린다).

POSTGRES_PASSWORD=

KALDI_JWT_SECRET=

# 브라우저가 백엔드를 직접 호출하므로(BFF는 auth 3개뿐) 반드시 운영 도메인을 넣는다.
# 비워두면 기본값 http://localhost:3000이 적용돼 운영 프론트의 요청이 전부 막힌다.
# localhost는 넣지 않는다 — 로컬 개발은 로컬 백엔드를 띄워서 한다.
KALDI_CORS_ALLOWED_ORIGINS=https://kaldi-note.today

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 카카오 콘솔·프론트 번들·이 값 셋이 문자 하나까지 같아야 인가코드 교환이 된다.
KAKAO_REDIRECT_URI=https://kaldi-note.today/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

OCI_TENANCY_ID=
OCI_USER_ID=
OCI_FINGERPRINT=

# 여러 줄 PEM이다. 반드시 큰따옴표로 감싼다 — 따옴표가 없으면 docker compose가
# 첫 줄만 읽어 자격증명이 깨진다(Compose v5.5.0에서 따옴표 있으면 개행 보존 확인).
#   OCI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
#   ...
#   -----END PRIVATE KEY-----"
OCI_PRIVATE_KEY=

OCI_REGION=ap-chuncheon-1
OCI_NAMESPACE=

# 사진용. public-read 버킷이다 (object_key가 UUID라 URL 추측이 불가능하다는 것이 근거).
OCI_BUCKET_NAME=

# DB 백업용. 반드시 위와 다른 private 버킷이어야 한다 — 백업 파일명은 날짜 기반이라
# 추측 가능해서, public 버킷에 두면 DB 덤프 전체가 공개된다.
OCI_BACKUP_BUCKET_NAME=

# 테스트 로그인. OAuth 없이 세션을 발급하는 인증 우회다.
#
# ★ 이 값이 유출되면 운영의 모든 계정 — 실제 카카오·구글 계정 포함 — 으로 로그인할 수 있다.
#   32자 미만이면 기능이 켜지지 않는다. 만료가 없으므로 끄려면 이 줄을 지우고 재배포한다.
#   자세한 내용: docs/specs/2026-09-05-test-login.md의 경고 상자
KALDI_TEST_LOGIN_SECRET=
